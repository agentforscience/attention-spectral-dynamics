\@writefile{lot}{\contentsline {table}{\numberline {8}{\ignorespaces Layer-level fits of $\hat  {I}_{\mathrm  {BD}}=a+bH(Y|X)+c/\sqrt  n$. The $\epsilon =0.2$ fits are omitted since they sit at the $\qopname  \relax o{log}M$ ceiling, and $\epsilon \le 1$ is ceiling-affected. No scale gives both $b$ near 1 and $a$ near 0. Per-head fits at $\epsilon =2$ give $a=0.18$, $b=0.25$ [0.09, 0.41] on \textsc  {Order}\xspace  and $a=0.20$, $b=0.08$ [0.05, 0.11] on \textsc  {AG News}\xspace  , so they also fail.}}{12}{table.8}\protected@file@percent }
\newlabel{tab:regression}{{8}{12}{Layer-level fits of $\Ibd =a+bH(Y|X)+c/\sqrt n$. The $\epsilon =0.2$ fits are omitted since they sit at the $\log M$ ceiling, and $\epsilon \le 1$ is ceiling-affected. No scale gives both $b$ near 1 and $a$ near 0. Per-head fits at $\epsilon =2$ give $a=0.18$, $b=0.25$ [0.09, 0.41] on \order and $a=0.20$, $b=0.08$ [0.05, 0.11] on \agnews , so they also fail}{table.8}{}}
