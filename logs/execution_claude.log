src/prune_finetune.py <<'EOF'\n\"\"\"Secondary H3 arm: after removing heads with S < tau*log n, fine-tune the rest for 5% of the training steps at lr/10.\"\"\"\nimport argparse\nimport json\nimport os\nimport sys\n\nsys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))\nimport numpy as np\nimport torch\nimport torch.nn.functional as F\n\nfrom model import Encoder\nfrom train import BASE, CONFIGS, accuracy, augment, mk_masks\n\n\ndef main(a):\n    cfg = dict(BASE, **CONFIGS[a.config])\n    tag = f\"results/runs/{a.config}_s{a.seed}\"\n    out = f\"{tag}.ft.json\"\n    if os.path.exists(out):\n        return\n    j = json.load(open(tag + \".json\"))\n    S = np.array(j[\"pruning\"][\"S_norm\"])\n    off = [(int(l), int(h)) for l, h in zip(*np.where(S < a.tau))]\n    torch.manual_seed(a.seed + 100)\n    D = torch.load(f\"datasets/prepared/{cfg['data']}.pt\", weights_only=False)\n    kind = \"vit\" if cfg[\"data\"] == \"cifar\" else \"text\"\n    kw = dict(classes=D[\"classes\"], max_len=D[\"max_len\"], d=cfg[\"d\"], heads=cfg[\"heads\"], layers=cfg[\"layers\"],\n              mlp_ratio=cfg[\"mlp_ratio\"], pre_ln=cfg[\"pre_ln\"])\n    model = Encoder(\"vit\", **kw) if kind == \"vit\" else Encoder(\"text\", vocab=D[\"vocab\"], **kw)\n    model.load_state_dict(torch.load(tag + \".pt\", map_location=\"cpu\"))\n    try:\n        model.cuda()\n        xtr, ytr = D[\"train\"][0].cuda(), D[\"train\"][1].cuda()\n        xte, yte = D[\"test\"][0].cuda(), D[\"test\"][1].cuda()\n        masks = mk_masks(model, off)\n        before = accuracy(model, xte, yte, kind, masks)\n        steps = int(.05 * j[\"n_step\"])\n        opt = torch.optim.AdamW(model.parameters(), lr=cfg[\"lr\"] / 10, weight_decay=cfg[\"wd\"])\n        model.train()\n        for _ in range(steps):\n            idx = torch.randint(0, len(xtr), (cfg[\"bs\"],), device=xtr.device)\n            xb = augment(xtr[idx]) if kind == \"vit\" else xtr[idx]\n            loss = F.cross_entropy(model(xb, masks), ytr[idx])\n            opt.zero_grad(set_to_none=True)\n            loss.backward()\n            opt.step()\n        after = accuracy(model, xte, yte, kind, masks)\n    except RuntimeError as e:\n        print(\"no room\", str(e)[:200])\n        os._exit(75)\n    json.dump(dict(config=a.config, seed=a.seed, tau=a.tau, frac=len(off) / S.size, base=j[\"test\"], before=before, after=after, steps=steps), open(out, \"w\"))\n\n\nif __name__ == \"__main__\":\n    ap = argparse.ArgumentParser()\n    ap.add_argument(\"--config\", required=True)\n    ap.add_argument(\"--seed\", type=int, required=True)\n    ap.add_argument(\"--tau\", type=float, default=0.3)\n    main(ap.parse_args())\nEOF\n.venv/bin/python -I -c \"import ast;ast.parse(open('src/prune_finetune.py').read());ast.parse(open('src/train.py').read())\"; wc -l logs/jobs/done.txt; tail -2 logs/queue.log; grep -c 'rc 75' logs/queue.log; grep -v 'rc 75' logs/queue.log | grep -c ' rc '","description":"Add large-init arm and fine-tune script, extend job grid"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1916,"cache_read_input_tokens":143439,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1916},"output_tokens":6,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"30402c77-19f2-456c-9b5e-2e376add52e6","uuid":"b44cdca5-8c01-4063-8845-8e048ce85040","timestamp":"2026-10-31T02:30:50.214Z","request_id":"req_011CgZXcKxiAXyZvzFRJ7jmu","wire_tool_inputs":{"toolu_01Mf5qzYgrX3dPYDo4DRVyPZ":{"command":"cd /data/summereunann/neurico-workspaces/attention_spectral_dynamics_20261030_140001_math02\n.venv/bin/python -I - <<'EOF'\nimport os\ns=open('src/train.py').read()\ns=s.replace('''    \"bert_ag\": dict(''','''    # post-plan addition: start from sharply peaked attentio