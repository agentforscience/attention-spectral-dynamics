for j in jobs if j[1] not in d and j[1] not in running and fails.get(j[1], 0) < 3]\n    if not todo and not running:\n        break\n    if todo and len(running) < max_run and time.time() - last >= gap:\n        g = gpus()\n        for need, tag, cmd in todo:\n            fit = [x for x in g if x[0] / 1024 >= float(need) + 0.4]\n            if fit:\n                f = open(f\"logs/jobs/{tag}.log\", \"a\")\n                e = dict(env, CUDA_VISIBLE_DEVICES=str(fit[0][1]))\n                running[tag] = (subprocess.Popen(cmd, shell=True, stdout=f, stderr=subprocess.STDOUT, env=e), f)\n                last = time.time()\n                print(time.strftime(\"%H:%M\"), \"start\", tag, \"gpu\", fit[0][1], \"free\", fit[0][0], flush=True)\n                break\n    time.sleep(3)\nprint(\"QUEUE EMPTY\", time.strftime(\"%H:%M\"), flush=True)\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":6853,"cache_read_input_tokens":77524,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":6853},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"30402c77-19f2-456c-9b5e-2e376add52e6","uuid":"48733192-a3b6-451b-bbaa-5a455faef096","timestamp":"2026-10-31T02:03:10.579Z","request_id":"req_011CgZVG6T4gmLDedDBx5HFj","wire_tool_inputs":{"toolu_016PxA4T4TzA1zB9Dtudm6Wm":{"file_path":"/data/summereunann/neurico-workspaces/attention_spectral_dynamics_20261030_140001_math02/src/queue_runner.py","content":"\"\"\"Single GPU queue. usage: queue_runner.py <jobs file> <max running> <gap seconds>\n\nJobs file lines: `<need_gb> <tag> <command...>`; finished tags go to logs/jobs/done.txt, so restarts skip them.\nThe file is re-read each cycle, so jobs can be appended. Exit code 75 requeues.\n\"\"\"\nimport os\nimpor